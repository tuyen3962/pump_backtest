[Unit]
Description=Pump Signal Recorder (memecatcher Signal Stream)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pump
Group=pump
WorkingDirectory=/opt/pump_backtest
EnvironmentFile=-/etc/pump-backtest.env
ExecStart=/opt/pump_backtest/bin/signal-recorder -out /opt/pump_backtest/data/signals -channel signals
Restart=always
RestartSec=5
LimitNOFILE=65535
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/pump_backtest/data

[Install]
WantedBy=multi-user.target
